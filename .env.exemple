# VARIÁVEIS SQL
#_rotinas.py
SQL_ROUTINES_TO_EXECUTE="SELECT * FROM cadastro_rotinas WHERE id_rotina NOT IN ( SELECT id_rotina FROM cadastro_rotinas WHERE status = 'E' ) AND ativo = 'S' ORDER BY ID_ROTINA"
SQL_CHECK_EMAIL_SENT="SELECT enviado FROM cadastro_rotinas WHERE id_rotina = :1"
SQL_UPDATE_SET_TO_E_N="UPDATE cadastro_rotinas SET status = 'E', enviado = 'N' WHERE id_rotina = :1"
SQL_UPDATE_SCHEDULE_MINUTE="UPDATE cadastro_rotinas SET dta_proxima = :1 + numtodsinterval(:2, 'MINUTE') WHERE id_rotina = :3"
SQL_UPDATE_SCHEDULE_HOUR="UPDATE cadastro_rotinas SET dta_proxima = :1 + numtodsinterval(:2, 'HOUR') WHERE id_rotina = :3"
SQL_UPDATE_SCHEDULE_DAY="UPDATE cadastro_rotinas SET dta_proxima = :1 + :2 WHERE id_rotina = :3"
SQL_UPDATE_SCHEDULE_MONTH="UPDATE cadastro_rotinas SET dta_proxima = ADD_MONTHS(:1, :2) WHERE id_rotina = :3"
SQL_UPDATE_DISABLE_ROUTINE="UPDATE cadastro_rotinas SET ATIVO = 'N' WHERE id_rotina = :1"
SQL_UPDATE_SET_TO_F_S="UPDATE cadastro_rotinas SET status = 'F', enviado = 'S', tent_erro = 0 WHERE id_rotina = :1"
SQL_UPDATE_SET_STATUS_TO_NULL="UPDATE cadastro_rotinas SET status = NULL WHERE id_rotina = :1"
SQL_GET_COLUMN_NAMES="SELECT column_name FROM user_tab_columns WHERE table_name = :1 ORDER BY column_id"
SQL_GET_RECIPIENTS="SELECT email FROM email_rotinas WHERE id_rotina = :1"
SQL_GET_HIPERLINK="SELECT CORPO, HIPER_LINK FROM ESTRUTURA_INFORMATIVO WHERE ID_ROTINA = :1 ORDER BY CODIGO"

#_utils.py
SQL_ATTEMPT_ERROR="SELECT tent_erro FROM cadastro_rotinas WHERE id_rotina = :1 AND tent_erro >= 5"
SQL_UPDATE_RESET_TENT_ERRO="UPDATE cadastro_rotinas SET tent_erro = 0, ativo = 'N' WHERE id_rotina = :1"
SQL_UPDATE_TENT_ERRO="UPDATE cadastro_rotinas SET tent_erro = CASE WHEN tent_erro IS NULL THEN 1 WHEN tent_erro >= 0 THEN tent_erro + 1 END WHERE id_rotina = :1"
